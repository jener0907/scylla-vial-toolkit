<Window x:Class="ScyllaConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scylla 설정 도우미" Width="1320" Height="780" MinWidth="1120" MinHeight="680"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
      <TextBlock Text="Scylla 설정 도우미" FontSize="27" FontWeight="Bold" />
      <TextBlock Text="Scylla 58키 키맵 설정" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,4,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#E56B6F" Margin="0,0,8,0" />
      <TextBlock x:Name="StatusText" Text="키보드 연결 안 됨" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PanelBorder}" Padding="10,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="Layer0Button" Tag="0" Content="Layer 0 · 기본" Click="LayerButton_Click" Style="{StaticResource LayerButton}" />
        <Button x:Name="Layer1Button" Tag="1" Content="Layer 1 · Fn" Click="LayerButton_Click" Style="{StaticResource LayerButton}" />
        <Button x:Name="Layer2Button" Tag="2" Content="Layer 2 · 숫자" Click="LayerButton_Click" Style="{StaticResource LayerButton}" />
        <Button x:Name="Layer3Button" Tag="3" Content="Layer 3 · 사용자" Click="LayerButton_Click" Style="{StaticResource LayerButton}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,14,14,0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Canvas x:Name="KeyCanvas" Width="850" Height="395" />
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,14,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="선택한 키" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="SelectedKeyText" Text="키를 선택하세요" FontSize="22" FontWeight="Bold" Margin="0,4,0,18" />
        <TabControl x:Name="EditorTabs" Margin="0,0,0,14">
          <TabItem Header="키 지정">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="현재 키코드" Foreground="{StaticResource MutedTextBrush}" />
              <TextBox x:Name="KeycodeTextBox" Margin="0,6,0,10" Padding="8" FontSize="16" Background="#111820" Foreground="{StaticResource TextBrush}" BorderBrush="#3B4B5B" />
              <TextBlock Text="빠른 선택" Foreground="{StaticResource MutedTextBrush}" />
              <ComboBox x:Name="QuickKeyCombo" Margin="0,6,0,12" Padding="6" FontSize="14" />
              <Button Content="이 키에 적용" Click="ApplyKey_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
              <Button x:Name="CaptureButton" Content="키 입력 모드 시작" Click="CaptureKey_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
              <CheckBox x:Name="AutoSaveCheckBox" Content="변경 즉시 키보드에 저장" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
              <TextBlock Text="입력 모드는 종료할 때까지 유지됩니다." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            </StackPanel>
          </TabItem>
          <TabItem Header="커스텀 키">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="저장된 커스텀 키" Foreground="{StaticResource MutedTextBrush}" />
              <ComboBox x:Name="SavedComboList" Height="36" Margin="0,6,0,8" SelectionChanged="SavedComboList_SelectionChanged" />
              <TextBlock x:Name="SavedComboPreviewText" Text="저장된 커스텀 키를 선택하세요." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,8" />
              <Button Content="선택한 커스텀 키 적용" Click="ApplySavedCombo_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
              <Button Content="선택한 커스텀 키 삭제" Click="DeleteCustomCombo_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,12" />
              <Expander Header="새 커스텀 키 만들기" Foreground="{StaticResource TextBrush}">
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="이름" Foreground="{StaticResource MutedTextBrush}" />
                  <TextBox x:Name="ComboNameTextBox" Margin="0,5,0,8" Padding="7" Background="#111820" Foreground="{StaticResource TextBrush}" BorderBrush="#3B4B5B" />
                  <WrapPanel Margin="0,0,0,8">
                    <CheckBox x:Name="ComboCtrlCheckBox" Content="Ctrl" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" Checked="ComboPart_Changed" Unchecked="ComboPart_Changed" />
                    <CheckBox x:Name="ComboShiftCheckBox" Content="Shift" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" Checked="ComboPart_Changed" Unchecked="ComboPart_Changed" />
                    <CheckBox x:Name="ComboAltCheckBox" Content="Alt" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" Checked="ComboPart_Changed" Unchecked="ComboPart_Changed" />
                    <CheckBox x:Name="ComboWinCheckBox" Content="Win" Foreground="{StaticResource TextBrush}" Checked="ComboPart_Changed" Unchecked="ComboPart_Changed" />
                  </WrapPanel>
                  <ComboBox x:Name="ComboMainKeyCombo" Margin="0,0,0,8" Padding="6" FontSize="14" SelectionChanged="ComboPart_Changed" />
                  <TextBlock x:Name="NewComboPreviewText" Text="새 조합키 미리보기" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,8" />
                  <Button Content="커스텀 키 저장" Click="SaveCustomCombo_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </TabItem>
          <TabItem Header="매크로">
            <StackPanel Margin="0,12,0,0">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="매크로 슬롯" Foreground="{StaticResource MutedTextBrush}" />
                  <ComboBox x:Name="MacroSlotCombo" Margin="0,5,8,0" Padding="6" FontSize="14" SelectionChanged="MacroSlotCombo_SelectionChanged" />
                </StackPanel>
                <Button Grid.Column="1" Content="장치에서 읽기" Click="ReadMacroButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,0,0,0" />
              </Grid>
              <Border Background="#111820" BorderBrush="#3B4B5B" BorderThickness="1" CornerRadius="7" Padding="7" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="실행 순서" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,5" />
                  <ListBox x:Name="MacroStepsList" Height="138" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#202B37" CornerRadius="5" Padding="7,5" Margin="0,0,0,4">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="54" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource TextBrush}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
              <TextBlock Text="동작 추가" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,5" />
              <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="74" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MacroActionTypeCombo" Margin="0,0,5,0" Padding="5" />
                <ComboBox x:Name="MacroActionKeyCombo" Grid.Column="1" Margin="0,0,5,0" Padding="5" />
                <TextBox x:Name="MacroDelayTextBox" Grid.Column="2" Text="100" Padding="5" Background="#111820" Foreground="{StaticResource TextBrush}" BorderBrush="#3B4B5B" ToolTip="지연 시간(ms)" />
                <Button Grid.Column="3" Content="추가" Click="AddMacroActionButton_Click" Style="{StaticResource PrimaryButton}" Padding="8,5" Margin="0" />
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.35*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RecordMacroButton" Content="녹화 시작" Click="RecordMacroButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" />
                <Button Grid.Column="1" Content="위로" Click="MoveMacroActionButton_Click" Tag="up" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" />
                <Button Grid.Column="2" Content="아래로" Click="MoveMacroActionButton_Click" Tag="down" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" />
                <Button Grid.Column="3" Content="삭제" Click="DeleteMacroActionButton_Click" Style="{StaticResource SecondaryButton}" Margin="0" />
              </Grid>
              <TextBlock Text="탭: 한 번 누름 · 누름/뗌: 길게 유지 · 지연: 다음 동작까지 대기" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8" />
              <Button Content="저장하고 선택 키에 지정" Click="SaveMacroButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0" />
            </StackPanel>
          </TabItem>
        </TabControl>
        <Separator Margin="0,0,0,10" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="키맵 다시 읽기" Click="ReadButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,5,5" />
          <Button Grid.Column="1" Content="키맵 저장" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,5" />
          <Button Grid.Row="1" x:Name="UndoButton" Content="변경 되돌리기" Click="UndoButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,5,5" IsEnabled="False" />
          <Button Grid.Row="1" Grid.Column="1" Content="Vial 잠금 해제" Click="UnlockButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,5" />
          <Button Grid.Row="2" Grid.ColumnSpan="2" Content="연결 새로 고침" Click="ConnectButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0" />
        </Grid>
        <TextBlock x:Name="DeviceInfoText" Text="" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="FooterText" Text="USB는 오른쪽 master에 연결하세요." VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
  </Grid>
</Window>
